# ========================================================
# PodMesh Suite — Configuration Environnement PRODUCTION
# ========================================================

# MeshFS Pure Rust
MESHFS_PORT=7443
MESHFS_DATA_DIR=/var/lib/meshfs
MESHFS_SOCKET=/var/lib/meshfs/meshfs.sock
MESHFS_CHUNK_SIZE_MB=4
MESHFS_DEBUG=false

# PMBS Pure Rust (Backup Server)
PMBS_PORT=8007
PMBS_DATA_DIR=/var/lib/pmbs
PMBS_SOCKET=/var/lib/pmbs/pmbs.sock
PMBS_DEFAULT_DATASTORE=datastore-default
PMBS_DEBUG=false

# PodMesh Core
PODMESH_PORT=8080
PODMESH_SOCKET=/run/podmesh/podmesh.sock
PODMESH_STATE_DIR=/var/lib/podmesh
