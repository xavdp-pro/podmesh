#!/usr/bin/env python3
"""Host-side publisher follow, under a written mandate -- and under nothing else.

The daemon still does not elect an active manager or mint a takeover proof. This tick reads
publisher_status, starts the connector when this host is eligible at that epoch -- with the installed
proof when it is for that epoch, or without one, the node then resuming under the proof it already
verified for the epoch when the lease is the same incarnation (V3-1) -- and stops it when this host is
not eligible. When the only gate missing is the service address, it asks the node once to resume the
recorded exclusive route and alias (network_route_resume), which the node refuses unless the lease is
live, held here, unsuperseded and renewed during this boot. On a running connector it checks what
eligibility does not: the mark's epoch, the origin ready at the lease's epoch, and the connector's
registration in its current run; on a mismatch it stops it, and the next tick starts it again under
the resume rule. It never changes the holder. See docs/PUBLISHER-FOLLOW-LAB.md.

A mandate that renews is BOUNDED, and refused otherwise. An unbounded renewal would push the
holder's lease forward for ever, and lease expiry is the only thing that withdraws an active
manager nobody can reach: with it gone, a partitioned host keeps publishing while a standby
takes the role at the barrier, which is the two-connector case the contract forbids. So
`renew=1` requires `not_after` (the wall-clock second the mandate dies) and `renew_below`
(renew only inside that many seconds of the lease's end, which also keeps the journal from
growing by one row every tick). After `not_after` the tick grants nothing more and renews
nothing: what is published runs out its lease and the tick's own stop branch withdraws it. It
resumes nothing either, route or connector: after `not_after` the tick only reads and stops.
"""
import hashlib, json, os, subprocess, sys, tempfile, time, uuid

MANDATE = os.environ.get("PODMESH_PUBLISHER_FOLLOW_MANDATE", "/etc/podmesh/publisher-follow-mandate")
CLI = os.environ.get("PODMESH_CLI", "/usr/bin/podmesh")
SOCKET = os.environ.get("PODMESH_SOCKET", "/run/podmesh/api.sock")
# What one tick leaves the next, under /run: gone with the boot, as the mandate and the proof are.
STATE = os.environ.get("PODMESH_PUBLISHER_FOLLOW_STATE", "/run/podmesh-publisher-follow/tick-state.json")
# A running connector is stopped at once on a positive mismatch, and on a reading that could not be
# made only when it could not be made this many ticks in a row: one podman exec that fails, one
# manager_status that times out, must not take a healthy page down (review of V3-1).
UNKNOWN_TICKS = 3
# After a failed start, the next one waits, doubling from this up to the ceiling: a start that cannot
# register holds the one-request-at-a-time daemon for up to 60 seconds.
BACKOFF_FIRST, BACKOFF_CEILING = 20, 300


def fail(msg, code=3):
    print(f"podmesh-publisher-follow: {msg}", file=sys.stderr)
    sys.exit(code)


def load_mandate(path):
    if not os.path.isfile(path):
        fail(f"no mandate at {path}; nothing is published without one")
    vals = {}
    for line in open(path, encoding="utf-8"):
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        vals[k.strip()] = v.strip()
    ref = vals.get("authorization_ref", "")
    resource = vals.get("resource", "")
    proof_path = vals.get("proof", "")
    renew = vals.get("renew", "0")
    not_after = vals.get("not_after", "")
    renew_below = vals.get("renew_below", "")
    if not ref or any(c for c in ref if c not in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.:-"):
        fail("the mandate names no usable authorization_ref")
    if not resource or any(c for c in resource if c not in "abcdefABCDEF0123456789-"):
        fail("the mandate names no usable resource UUID")
    if not proof_path or ".." in proof_path.split("/") or not proof_path.startswith("/"):
        fail("the mandate names no usable absolute proof path")
    if renew not in ("0", "1"):
        fail("the mandate's renew must be 0 or 1")
    if not not_after.isdigit():
        fail("the mandate must carry not_after, the wall-clock second it dies")
    if renew == "1" and not renew_below.isdigit():
        fail("a mandate that renews must carry renew_below, the seconds of lease left below which it renews")
    below = int(renew_below) if renew_below.isdigit() else 0
    if renew == "1" and not 0 < below <= 86400:
        fail("the mandate's renew_below must be from 1 to 86400 seconds")
    return ref, resource, proof_path, renew == "1", int(not_after), below


def cli(operation, payload):
    env = dict(os.environ, PODMESH_SOCKET=SOCKET)
    request = dict(payload)
    fd, path = tempfile.mkstemp(prefix="podmesh-publisher-follow-")
    try:
        os.chmod(path, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(request, f)
        p = subprocess.run([CLI, operation, path], env=env, capture_output=True, text=True)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    if p.returncode:
        try:
            return json.loads(p.stdout or p.stderr or "{}"), p.returncode
        except json.JSONDecodeError:
            fail(f"{operation} failed ({p.returncode}): {(p.stderr or p.stdout)[-800:]}", 1)
    return json.loads(p.stdout), 0


def maybe_renew(ref, resource):
    renewed, rc = cli(
        "activation_renew",
        {"universe_uuid": resource, "operation_id": str(uuid.uuid4()), "authorization_ref": ref},
    )
    if rc or not renewed.get("ok"):
        fail(f"activation_renew refused: {renewed.get('error') or renewed}", 1)


def request(ref, **fields):
    return {"operation_id": str(uuid.uuid4()), "authorization_ref": ref, **fields}


def read_status(ref, resource):
    status, code = cli("publisher_status", request(ref, resource=resource))
    if code or not status.get("ok"):
        fail(f"publisher_status refused: {status.get('error') or status}", 1)
    return status.get("data") or {}


def only_the_address_missing(data):
    """Eligible but for the service address: every other gate passes, by name (publisher_status's
    `gates`), so that a lease lost, a policy gone or a credential missing never leads to a resume."""
    gates = data.get("gates") or {}
    return (data.get("publisher_eligible") is not True and gates.get("service_address") is False
            and all(gates.get(g) is True for g in ("lease", "policy", "credential")))


def load_state():
    try:
        with open(STATE, encoding="utf-8") as f:
            state = json.load(f)
        return state if isinstance(state, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(state):
    try:
        os.makedirs(os.path.dirname(STATE), mode=0o700, exist_ok=True)
        tmp = STATE + ".partial"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f)
        os.replace(tmp, STATE)
    except OSError as e:
        print(f"podmesh-publisher-follow: the tick's state could not be kept at {STATE}: {e}", file=sys.stderr)


def check_running(data):
    """What eligibility does not say about a running connector, from publisher_status alone: the mark
    names the lease's epoch, the origin answers ready at that epoch with the carrier's replica, and the
    connector registered in its current run. ("mismatch", why) on a positive mismatch -- a mark absent
    or at another epoch, an origin that answered otherwise; ("unknown", why) when a reading could not be
    made, or the current run's journal shows no registration; None when all three hold. A node older
    than these fields reports none of them; nothing is compared then, rather than a healthy connector
    stopped at every tick until the node is rolled."""
    if not all(k in data for k in ("active_manager_mark_read", "origin_ready_at_lease_epoch", "connector_registered")):
        return None
    epoch = data.get("epoch")
    mark = data.get("active_manager_mark_read")
    if mark == "absent":
        return "mismatch", "no active manager's mark in the carrier"
    if mark == "present" and data.get("active_manager_mark_epoch") != epoch:
        return "mismatch", f"the active manager's mark names epoch {data.get('active_manager_mark_epoch')}, the lease is under epoch {epoch}"
    if data.get("origin_ready_at_lease_epoch") is False:
        return "mismatch", f"the origin is not ready at epoch {epoch}: {json.dumps(data.get('origin_readiness'))[:300]}"
    if mark != "present":
        return "unknown", f"the mark could not be read: {data.get('active_manager_mark_error')}"
    if data.get("origin_ready_at_lease_epoch") is None:
        return "unknown", f"the origin's readiness could not be told: {json.dumps(data.get('origin_readiness'))[:300]}"
    if data.get("connector_registered") is None:
        return "unknown", f"the current run's journal could not be read: {data.get('connector_registration_error')}"
    if data.get("connector_registered") is not True:
        return "unknown", "the connector's current run shows no registration with Cloudflare in its journal"
    return None


def stop(ref, resource, why):
    print(f"podmesh-publisher-follow: stopping the connector: {why}", file=sys.stderr)
    result, code = cli("publisher_stop", request(ref, resource=resource))
    if code or not result.get("ok"):
        fail(f"publisher_stop refused: {result.get('error') or result}", 1)


def installed_proof(proof_path, epoch, state):
    """The installed proof when it is a document for the lease's epoch, else None: the node then
    resumes under the proof it already verified, or refuses. A file that cannot be read or is not a
    document (a partial copy, say) is reported once per content, never a crash."""
    if not os.path.isfile(proof_path):
        return None
    raw = b""
    try:
        raw = open(proof_path, "rb").read()
        proof = json.loads(raw.decode("utf-8"))
        if not isinstance(proof, dict):
            raise ValueError("not a JSON object")
    except (OSError, ValueError) as e:
        digest = hashlib.sha256(raw).hexdigest()
        if state.get("proof_warned") != digest:
            print(f"podmesh-publisher-follow: the installed proof at {proof_path} cannot be used ({e}); starting without it", file=sys.stderr)
            state["proof_warned"] = digest
        return None
    state.pop("proof_warned", None)
    if proof.get("new_epoch") != epoch:
        print(f"podmesh-publisher-follow: installed proof is for epoch {proof.get('new_epoch')}, lease epoch is {epoch}; "
              "starting without it, under the same-epoch resume", file=sys.stderr)
        return None
    return proof


def main():
    ref, resource, proof_path, renew, not_after, renew_below = load_mandate(MANDATE)
    now = int(time.time())
    expired = now >= not_after
    data = read_status(ref, resource)
    if not data.get("declared"):
        sys.exit(0)
    # The service address lost with its carrier (a replica stopped and started, a roll at the same
    # address): the node is asked once to put the recorded route and alias back, and decides; a
    # refusal (nothing runs at the address yet, a lease not renewed this boot) is reported and the tick
    # goes on with what it read. Never after the mandate's end.
    if only_the_address_missing(data) and not expired:
        resumed, rc = cli("network_route_resume", request(ref, exclusive_resource=resource))
        if rc or not resumed.get("ok"):
            print(f"podmesh-publisher-follow: network_route_resume refused: {resumed.get('error') or resumed}", file=sys.stderr)
        else:
            data = read_status(ref, resource)
    unit_state = ((data.get("unit") or {}).get("state") or "")
    active = unit_state in ("active", "activating")
    eligible = data.get("publisher_eligible") is True
    epoch = data.get("epoch")
    state = load_state()
    # Renew only inside the window the mandate names, and never once the mandate has died: the
    # lease must be able to lapse, both at the end of the demonstration and on a host nobody can
    # reach.
    if eligible and renew and not expired:
        expires_at = ((data.get("lease") or {}).get("expires_at")) or 0
        if expires_at - now <= renew_below:
            maybe_renew(ref, resource)
    if not eligible:
        state.pop("unknown_ticks", None)
        save_state(state)
        if active or data.get("transition"):
            stop(ref, resource, "this host is not eligible: " + "; ".join(data.get("reasons") or []))
        sys.exit(0)
    if active:
        verdict = check_running(data)
        if verdict is None:
            state.pop("unknown_ticks", None)
        elif verdict[0] == "mismatch":
            state.pop("unknown_ticks", None)
            save_state(state)
            stop(ref, resource, verdict[1])
        else:
            state["unknown_ticks"] = state.get("unknown_ticks", 0) + 1
            if state["unknown_ticks"] >= UNKNOWN_TICKS:
                state.pop("unknown_ticks", None)
                save_state(state)
                stop(ref, resource, f"{verdict[1]} ({UNKNOWN_TICKS} ticks in a row)")
            else:
                print(f"podmesh-publisher-follow: {verdict[1]} (tick {state['unknown_ticks']} of {UNKNOWN_TICKS} before a stop)", file=sys.stderr)
        save_state(state)
        sys.exit(0)
    state.pop("unknown_ticks", None)
    if expired:
        save_state(state)
        fail(f"the mandate died at {not_after}; nothing is started under it (what is published runs out its lease)", 0)
    # A failed start holds the daemon for up to a minute: the next one waits, doubling, and a new
    # epoch starts the count again.
    if state.get("start_epoch") != epoch:
        for k in ("start_failures", "next_start_at"):
            state.pop(k, None)
    if now < state.get("next_start_at", 0):
        save_state(state)
        fail(f"a start failed {state.get('start_failures')} time(s); the next is not before {state['next_start_at']}", 0)
    fields = {"resource": resource, "previous": {"source": "publisher-follow"}}
    proof = installed_proof(proof_path, epoch, state)
    if proof is not None:
        fields["takeover_proof"] = proof
    start, sc = cli("publisher_start", request(ref, **fields))
    if sc or not start.get("ok"):
        err = start.get("error") or ""
        if "already recorded or active" in err:
            save_state(state)
            sys.exit(0)
        failures = state.get("start_failures", 0) + 1
        state.update(start_failures=failures, start_epoch=epoch,
                     next_start_at=now + min(BACKOFF_CEILING, BACKOFF_FIRST * 2 ** (failures - 1)))
        save_state(state)
        fail(f"publisher_start refused: {err or start}", 1)
    for k in ("start_failures", "next_start_at", "start_epoch"):
        state.pop(k, None)
    save_state(state)
    sys.exit(0)


if __name__ == "__main__":
    main()
