# NEW canonical-unit candidate only. Build offline on the declared build host; never pull/apt.
FROM docker.io/library/mariadb@sha256:93fc3fe333b6cdfb061425869c2c3a5bb2851c0c74dbebc2c940f024e7482d76
ARG NODE_BINARY_SHA256
ARG ADMIN_BINARY_SHA256
ARG SUPERVISOR_SHA256
ARG GRANTS_SHA256
ARG BINARY_SOURCE_REVISION
ARG ADMIN_SOURCE_REVISION
ARG RECIPE_REVISION
USER root
COPY podmeshd podmesh-store-admin entrypoint.py grants.json /usr/lib/podmesh-node-canonical/
# Missing pre-existing Python/helper is a named hard build blocker, never a network install.
RUN for dep in /usr/bin/python3 /usr/bin/setpriv /usr/bin/mariadb /usr/bin/mariadb-install-db /usr/sbin/mariadbd; do \
      test -x "$dep" || { echo "canonical NODE missing base dependency: $dep" >&2; exit 1; }; done \
 && command -v useradd && command -v groupadd && command -v getent && command -v cut \
 && test "$(getent passwd mysql | cut -d: -f3)" -gt 0 \
 && ! getent passwd 1102 && ! getent group 1102 \
 && groupadd --gid 1102 podmesh-node \
 && useradd --uid 1102 --gid 1102 --home-dir /apps/podmesh-node --no-create-home --shell /usr/sbin/nologin podmesh-node \
 && chmod 0555 /usr/lib/podmesh-node-canonical/podmeshd /usr/lib/podmesh-node-canonical/podmesh-store-admin /usr/lib/podmesh-node-canonical/entrypoint.py \
 && chmod 0444 /usr/lib/podmesh-node-canonical/grants.json
# Never import/execute product binaries while constructing provenance.
RUN NODE_BINARY_SHA256="$NODE_BINARY_SHA256" ADMIN_BINARY_SHA256="$ADMIN_BINARY_SHA256" \
 SUPERVISOR_SHA256="$SUPERVISOR_SHA256" GRANTS_SHA256="$GRANTS_SHA256" \
 BINARY_SOURCE_REVISION="$BINARY_SOURCE_REVISION" ADMIN_SOURCE_REVISION="$ADMIN_SOURCE_REVISION" \
 RECIPE_REVISION="$RECIPE_REVISION" /usr/bin/python3 -I -c 'import os,re,json,hashlib,pathlib; assert hasattr(os,"WNOWAIT"); p=pathlib.Path("/usr/lib/podmesh-node-canonical"); pairs={"podmeshd":"NODE_BINARY_SHA256","podmesh-store-admin":"ADMIN_BINARY_SHA256","entrypoint.py":"SUPERVISOR_SHA256","grants.json":"GRANTS_SHA256"}; hashes={n:os.environ[k] for n,k in pairs.items()}; assert all(re.fullmatch("[0-9a-f]{64}",h) and hashlib.sha256((p/n).read_bytes()).hexdigest()==h for n,h in hashes.items()); pins={k:os.environ[k] for k in ("BINARY_SOURCE_REVISION","ADMIN_SOURCE_REVISION","RECIPE_REVISION")}; assert all(re.fullmatch("[0-9a-f]{40}",v) for v in pins.values()); f=p/"provenance.json"; f.write_text(json.dumps({"sha256":hashes,"source":pins,"minimum_engine_stop_timeout_seconds":60},sort_keys=True)); f.chmod(0o444)'
RUN mkdir -p /apps/podmesh-node/app /apps/podmesh-node/etc /apps/podmesh-node/sav /apps/podmesh-node/log /apps/podmesh-node/nosav \
 && chmod 0755 /apps /apps/podmesh-node /apps/podmesh-node/app /apps/podmesh-node/etc /apps/podmesh-node/sav /apps/podmesh-node/log /apps/podmesh-node/nosav /usr/lib/podmesh-node-canonical
# The inherited MariaDB /var/lib/mysql VOLUME is NEVER allowed to auto-materialize.
# Native delivery MUST use --image-volume=ignore, explicit etc/sav mounts and fresh /run.
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/python3", "-I", "/usr/lib/podmesh-node-canonical/entrypoint.py"]
