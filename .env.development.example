# ========================================================
# PodMesh Suite — Configuration Environnement DÉVELOPPEMENT
# ========================================================

# MeshFS Pure Rust
MESHFS_PORT=7443
MESHFS_DATA_DIR=./data/dev/meshfs
MESHFS_SOCKET=./data/dev/meshfs/meshfs.sock
MESHFS_CHUNK_SIZE_MB=4
MESHFS_DEBUG=true

# PMBS Pure Rust (Backup Server)
PMBS_PORT=8007
PMBS_DATA_DIR=./data/dev/pmbs
PMBS_SOCKET=./data/dev/pmbs/pmbs.sock
PMBS_DEFAULT_DATASTORE=datastore-default
PMBS_DEBUG=true

# Frontend Showcase / Manager
VITE_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_MESHFS_URL=http://127.0.0.1:7443
VITE_PMBS_URL=http://127.0.0.1:8007
